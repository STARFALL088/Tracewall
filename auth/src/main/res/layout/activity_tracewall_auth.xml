<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/auth_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_back"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/auth_back" />

        <TextView
            android:id="@+id/auth_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_title_initial"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5" />

        <TextView
            android:id="@+id/auth_role"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TracewallAuthSection" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auth_role_warning" />

        <TextView
            android:id="@+id/auth_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auth_intro" />

        <ProgressBar
            android:id="@+id/auth_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/auth_working"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/auth_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/auth_email_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/auth_email_section"
            android:textAppearance="@style/TracewallAuthSection" />

        <RadioGroup
            android:id="@+id/auth_email_modes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@id/auth_mode_sign_in"
            android:orientation="vertical"
            android:saveEnabled="false">
            <RadioButton
                android:id="@+id/auth_mode_sign_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:saveEnabled="false"
                android:text="@string/auth_sign_in" />
            <RadioButton
                android:id="@+id/auth_mode_create"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:saveEnabled="false"
                android:text="@string/auth_create_account" />
        </RadioGroup>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/auth_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auth_email_hint"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress"
            android:minHeight="56dp"
            android:saveEnabled="false"
            android:singleLine="true" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/auth_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auth_password_hint"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:minHeight="56dp"
            android:saveEnabled="false"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_password_help" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_email_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_sign_in" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_reauthenticate"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_reauthenticate_email"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_reset"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_reset_password" />

        <TextView
            android:id="@+id/auth_email_verification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_verify_email"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_verify_email"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_refresh_email"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_refresh_email"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_google"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/auth_google_sign_in" />

        <TextView
            android:id="@+id/auth_phone_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/auth_phone_section"
            android:textAppearance="@style/TracewallAuthSection" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auth_phone_security" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/auth_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auth_phone_hint"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:minHeight="56dp"
            android:saveEnabled="false"
            android:singleLine="true" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/auth_sms_consent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:minHeight="48dp"
            android:saveEnabled="false"
            android:text="@string/auth_phone_consent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_phone_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_send_code" />

        <TextView
            android:id="@+id/auth_cooldown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/auth_code_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/auth_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/auth_code_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:minHeight="56dp"
                android:saveEnabled="false"
                android:singleLine="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/auth_code_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_confirm_code" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_resend"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_resend_code"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_phone_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_change_phone"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/auth_initial_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/auth_guest"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_guest" />
            <TextView
                android:id="@+id/auth_guest_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_guest_help" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/auth_local"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_local" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_local_help" />
        </LinearLayout>

        <TextView
            android:id="@+id/auth_identity_lock_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/auth_identity_lock_notice"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
