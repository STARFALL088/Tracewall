<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:minHeight="64dp" android:padding="8dp" android:background="?attr/selectableItemBackground"
    android:focusable="true" android:clickable="true">
    <TextView android:id="@+id/appName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="17sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/appDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" />
</LinearLayout>
