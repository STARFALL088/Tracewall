<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp">
    <Button android:id="@+id/appsBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/apps_back" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/appsDevice" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="18sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/apps_scope_note" android:paddingTop="8dp" />
            <TextView android:id="@+id/appsStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite" android:paddingTop="8dp" android:paddingBottom="8dp" />
        </LinearLayout>
    </ScrollView>
    <EditText android:id="@+id/appsSearch" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/apps_search" android:inputType="text" android:maxLines="1" android:maxLength="200" android:importantForAutofill="no" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/appsList" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="3" android:scrollbars="vertical" />
</LinearLayout>
