<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/childUidLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp" />

    <LinearLayout android:id="@+id/tamperBanner"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#B71C1C" android:padding="8dp"
        android:orientation="horizontal" android:visibility="gone">
        <TextView android:id="@+id/tamperText"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="#FFFFFF" />
        <Button android:id="@+id/dismissTamper"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/dismiss_event" />
    </LinearLayout>
    <TextView android:id="@+id/lastSeen"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/last_seen_unknown" />
    <TextView android:id="@+id/ruleStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/rules_waiting" android:accessibilityLiveRegion="polite" />

    <!-- Allow-domain rule -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/dashboard_allow_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/allowInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/allowButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/dashboard_allow_button" />

    <!-- Block-UID rule -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/dashboard_block_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/blockUidInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/blockUidButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/dashboard_block_button" />

    <Button android:id="@+id/editRules"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/remove_rule" />

    <!-- Category toggles -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/dashboard_categories"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/catMalware"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="@string/cat_malware" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/catGambling"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="@string/cat_gambling" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/catAdult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="@string/cat_adult" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/catAds"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="@string/cat_ads" />

    </LinearLayout>

    <!-- History -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/dashboard_history"
        android:textSize="13sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</LinearLayout>
