{
  "rules": {
    ".read": false,
    ".write": false,
    "devices": {
      "$uid": {
        "rules": {
          ".read": "(auth != null && auth.uid === $uid) || (auth != null && root.child('devices').child($uid).child('parentUid').child(auth.uid).exists())",
          ".write": "auth != null && root.child('devices').child($uid).child('parentUid').child(auth.uid).exists()",
          "allow": {
            "$index": {
              ".validate": "newData.isString() && newData.val().length <= 253"
            }
          },
          "blocked_uids": {
            "$index": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2147483647"
            }
          },
          "categories": {
            "$category": {
              ".validate": "($category === 'adult' || $category === 'gambling' || $category === 'ads' || $category === 'malware') && newData.isBoolean()"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "parentUid": {
          ".read": "auth != null && auth.uid === $uid",
          "$parent": {
            ".write": "((auth != null && auth.uid === $uid) && !newData.exists()) || (auth != null && auth.uid === $parent && auth.uid !== $uid && !data.exists() && newData.isString() && newData.val() === data.parent().parent().child('pairing/code').val() && data.parent().parent().child('pairing/expires_ms').val() > now && !data.parent().parent().child('pairing/claimed_by').exists() && newData.parent().parent().child('pairing/claimed_by').val() === auth.uid)",
            ".read": "(auth != null && auth.uid === $uid) || (auth != null && auth.uid === $parent)"
          }
        },
        "pairing": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['code', 'expires_ms'])",
          "code": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{8}$/)"
          },
          "expires_ms": {
            ".validate": "newData.isNumber() && (newData.val() === data.val() || (newData.val() > now && newData.val() <= now + 330000))"
          },
          "claimed_by": {
            ".write": "auth != null && auth.uid !== $uid && !data.exists() && newData.val() === auth.uid && data.parent().child('expires_ms').val() > now && newData.parent().parent().child('parentUid').child(auth.uid).val() === data.parent().child('code').val()",
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        },
        "history": {
          ".read": "(auth != null && auth.uid === $uid) || (auth != null && root.child('devices').child($uid).child('parentUid').child(auth.uid).exists())",
          ".write": "auth != null && auth.uid === $uid"
        },
        "events": {
          ".read": "(auth != null && auth.uid === $uid) || (auth != null && root.child('devices').child($uid).child('parentUid').child(auth.uid).exists())",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
