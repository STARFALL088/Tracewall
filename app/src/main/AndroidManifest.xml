<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 11+ package visibility: without this, getInstalledPackages()
         sees a handful of packages and the per-app block screen would be near
         empty. Sideloaded parental app, so the Play restriction does not bite. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".TracewallApp"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tracewall">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Per-app block screen. exported=false: the parent manages it from
             the main screen, not other apps. -->
        <activity
            android:name=".ui.AppBlockActivity"
            android:exported="false"
            android:label="@string/apps_title" />

        <!-- Boot receiver: reports that protection did not come back. It
             cannot restart the tunnel itself on Android 8+, so it does not try. -->
        <receiver
            android:name=".boot.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Read-only history. exported=false: other apps cannot read a
             child's browsing history, which is the whole point. -->
        <provider
            android:name=".log.QueryLogProvider"
            android:authorities="tracewall.child.log"
            android:exported="false" />

        <!-- The VPN service. BIND_VPN_SERVICE is what makes the system trust
             it: without that permission the consent dialog never appears and
             prepare() returns a null intent that goes nowhere. -->
        <service
            android:name=".vpn.DnsVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>
</manifest>
