<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/tw_panel"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/appLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:breakStrategy="high_quality"
        android:textAppearance="@style/TextAppearance.Tracewall.Body"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/appPkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:breakStrategy="simple"
        android:textAppearance="@style/TextAppearance.Tracewall.Caption"
        android:textDirection="ltr" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/appSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/detail_apps_switch"
        android:textAppearance="@style/TextAppearance.Tracewall.Body" />
</LinearLayout>
