<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tw_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/historyBack"
        style="@style/Widget.Tracewall.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        app:navigationContentDescription="@string/detail_back"
        app:navigationIcon="@drawable/ic_tw_arrow_back"
        app:navigationIconTint="@color/tw_text"
        app:title="@string/detail_history_title" />

    <TextView
        android:id="@+id/historyStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.Tracewall.Caption" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/historyProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/tw_primary"
        app:trackColor="@color/tw_surface_variant" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/historySummaryBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tw_background"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="4dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp"
                app:layout_scrollFlags="scroll|enterAlways">

                <TextView
                    android:id="@+id/historySelection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Tracewall.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/historyFilters"
                    style="@style/Widget.Tracewall.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/history_filters"
                    app:icon="@drawable/ic_tw_search"
                    app:iconGravity="textStart" />

                <TextView
                    android:id="@+id/historyStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.Tracewall.Caption"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp"
                android:scrollbars="vertical"
                android:visibility="gone" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/historyEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_tw_activity"
                        app:tint="@color/tw_primary" />

                    <TextView
                        android:id="@+id/historyEmptyTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.Tracewall.Section" />

                    <TextView
                        android:id="@+id/historyEmptyMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.Tracewall.Body"
                        android:textColor="@color/tw_muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/historyEmptyAction"
                        style="@style/Widget.Tracewall.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/detail_history_change_filters"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <LinearLayout
        android:id="@+id/historyPages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tw_surface"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/historyPrevious"
            style="@style/Widget.Tracewall.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/history_newer"
            android:text="@string/detail_history_newer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/historyNext"
            style="@style/Widget.Tracewall.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:contentDescription="@string/history_older"
            android:text="@string/detail_history_older" />
    </LinearLayout>
</LinearLayout>
