<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/historyFilterScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tw_surface"
    android:fillViewport="true"
    android:focusableInTouchMode="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/historyDomain"
            android:text="@string/history_domain"
            android:textAppearance="@style/TextAppearance.Tracewall.Body"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/historyDomain"
            style="@style/Widget.Tracewall.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/detail_history_domain_hint"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLength="253"
            android:singleLine="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/detail_history_domain_help"
            android:textAppearance="@style/TextAppearance.Tracewall.Caption" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/historyApp"
            android:text="@string/history_app"
            android:textAppearance="@style/TextAppearance.Tracewall.Body"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/historyApp"
            style="@style/Widget.Tracewall.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/history_app_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:maxLength="200"
            android:singleLine="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/history_app_help"
            android:textAppearance="@style/TextAppearance.Tracewall.Caption" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/historyVerdictFilter"
            android:text="@string/history_verdict"
            android:textAppearance="@style/TextAppearance.Tracewall.Body"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/historyVerdictFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tw_inset_panel"
            android:minHeight="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:prompt="@string/history_verdict"
            android:spinnerMode="dialog" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/historyRange"
            android:text="@string/history_range"
            android:textAppearance="@style/TextAppearance.Tracewall.Body"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/historyRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tw_inset_panel"
            android:minHeight="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:prompt="@string/history_range"
            android:spinnerMode="dialog" />
        <LinearLayout
            android:id="@+id/historyCustomDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/historyStartDate"
                style="@style/Widget.Tracewall.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/historyEndDate"
                style="@style/Widget.Tracewall.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/history_dates_help"
                android:textAppearance="@style/TextAppearance.Tracewall.Caption" />
        </LinearLayout>
        <TextView
            android:id="@+id/historyFilterError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Tracewall.Body"
            android:textColor="@color/tw_danger"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
