<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/feedsCategory" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/feedsStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:accessibilityLiveRegion="polite" android:textStyle="bold" />
    <TextView android:id="@+id/feedsDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
    <TextView android:id="@+id/feedsSource" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textIsSelectable="true" android:lineSpacingExtra="3dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/feedsApprove"
        style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:visibility="gone" />
</LinearLayout>
