<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/tw_background"
    android:focusableInTouchMode="true">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" app:title="@string/app_name" app:subtitle="@string/nav_device_context"
        app:logo="@drawable/ic_tw_shield" app:titleMarginStart="12dp" />
    <TextView android:id="@+id/pageTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp"
        android:text="@string/nav_home_title" android:textAppearance="@style/TextAppearance.Tracewall.Title"
        android:accessibilityHeading="true" />
    <TextView android:id="@+id/pageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="6dp" android:paddingBottom="20dp"
        android:text="@string/nav_home_subtitle" android:textAppearance="@style/TextAppearance.Tracewall.Caption" />

    <!-- Each top-level destination owns its own content and scroll position. -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <include android:id="@+id/homePage" layout="@layout/page_home"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <include android:id="@+id/activityPage" layout="@layout/page_activity"
            android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
        <include android:id="@+id/protectPage" layout="@layout/page_protect"
            android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
        <include android:id="@+id/familyPage" layout="@layout/page_family"
            android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
        <include android:id="@+id/settingsPage" layout="@layout/page_settings"
            android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
    </FrameLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/tw_border" />
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/navigation"
        android:layout_width="match_parent" android:layout_height="80dp" android:minHeight="80dp"
        android:background="@color/tw_surface" app:elevation="0dp" app:menu="@menu/main_navigation"
        app:labelVisibilityMode="labeled" app:itemHorizontalTranslationEnabled="false"
        app:itemIconTint="@color/tw_nav_color" app:itemTextColor="@color/tw_nav_color"
        app:itemTextAppearanceActive="@style/TextAppearance.Tracewall.Nav"
        app:itemTextAppearanceInactive="@style/TextAppearance.Tracewall.Nav" />
</LinearLayout>
