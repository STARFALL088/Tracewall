<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/activityCount" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/nav_live_requests" android:textAppearance="@style/TextAppearance.Tracewall.Caption" />
        <com.google.android.material.button.MaterialButton android:id="@+id/openHistory" style="@style/Widget.Tracewall.Button.Text"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_saved_history" app:icon="@drawable/ic_tw_schedule" />
    </LinearLayout>
    <EditText android:id="@+id/queryFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:hint="@string/nav_search_hint" android:inputType="text" android:imeOptions="actionSearch" android:singleLine="true" android:importantForAutofill="no" />
    <com.google.android.material.button.MaterialButton android:id="@+id/clearSearch" style="@style/Widget.Tracewall.Button.Text" android:layout_gravity="end"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_clear_search" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingBottom="16dp" android:scrollbars="vertical" />
        <ScrollView android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="20dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_tw_activity" android:importantForAccessibility="no" android:contentDescription="@null" />
                <TextView android:id="@+id/emptyTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center"
                    android:text="@string/nav_empty_title" android:textAppearance="@style/TextAppearance.Tracewall.Section" />
                <TextView android:id="@+id/emptyBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center"
                    android:text="@string/nav_empty_off" android:textAppearance="@style/TextAppearance.Tracewall.Body" />
                <com.google.android.material.button.MaterialButton android:id="@+id/emptyAction" style="@style/Widget.Tracewall.Button.Outlined"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/nav_open_home" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
