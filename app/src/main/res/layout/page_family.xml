<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:paddingStart="20dp" android:paddingEnd="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/tw_panel" android:padding="24dp">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_tw_family" android:importantForAccessibility="no" android:contentDescription="@null" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/nav_pair_title" android:textAppearance="@style/TextAppearance.Tracewall.Section" android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/nav_pair_body" android:textAppearance="@style/TextAppearance.Tracewall.Body" />
            <TextView android:id="@+id/accountStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/tw_status_badge" android:padding="12dp" android:text="@string/account_local" android:textAppearance="@style/TextAppearance.Tracewall.Caption" />
            <TextView android:id="@+id/pairingAvailability" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/nav_pair_local" android:textAppearance="@style/TextAppearance.Tracewall.Caption" />
            <TextView android:id="@+id/deviceIdentity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="@style/TextAppearance.Tracewall.Caption" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/deviceCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/nav_pair_action" app:icon="@drawable/ic_tw_family" />
            <com.google.android.material.button.MaterialButton android:id="@+id/familyAccount" style="@style/Widget.Tracewall.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nav_pair_account" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/location_family_title" android:textAppearance="@style/TextAppearance.Tracewall.Section" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/location_family_body" android:textAppearance="@style/TextAppearance.Tracewall.Body" />
        <TextView android:id="@+id/locationStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/location_family_off" android:textAppearance="@style/TextAppearance.Tracewall.Caption" android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton android:id="@+id/locationOpen" style="@style/Widget.Tracewall.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/location_family_open" app:icon="@drawable/ic_tw_location" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/nav_sharing_title" android:textAppearance="@style/TextAppearance.Tracewall.Section" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/nav_sharing_body" android:textAppearance="@style/TextAppearance.Tracewall.Body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/shareAppNames" style="@style/Widget.Tracewall.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/inventory_off" app:icon="@drawable/ic_tw_apps" />
        <com.google.android.material.button.MaterialButton android:id="@+id/manageParents" style="@style/Widget.Tracewall.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nav_manage_parents" app:icon="@drawable/ic_tw_family" />
    </LinearLayout>
</ScrollView>
