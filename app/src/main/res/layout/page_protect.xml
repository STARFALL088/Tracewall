<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:paddingStart="20dp" android:paddingEnd="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/tw_panel" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nav_apps_title" android:textAppearance="@style/TextAppearance.Tracewall.Section" android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/nav_apps_body" android:textAppearance="@style/TextAppearance.Tracewall.Body" />
            <com.google.android.material.button.MaterialButton android:id="@+id/actionApps" style="@style/Widget.Tracewall.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/nav_apps_title" app:icon="@drawable/ic_tw_apps" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="20dp" android:background="@color/tw_border" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nav_domains_title" android:textAppearance="@style/TextAppearance.Tracewall.Section" android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/nav_domains_body" android:textAppearance="@style/TextAppearance.Tracewall.Body" />
            <com.google.android.material.button.MaterialButton android:id="@+id/openRules" style="@style/Widget.Tracewall.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/nav_domains_title" app:icon="@drawable/ic_tw_globe" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="20dp" android:background="@color/tw_border" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nav_schedules_title" android:textAppearance="@style/TextAppearance.Tracewall.Section" android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/nav_schedules_body" android:textAppearance="@style/TextAppearance.Tracewall.Body" />
            <com.google.android.material.button.MaterialButton android:id="@+id/openSchedules" style="@style/Widget.Tracewall.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/nav_schedules_title" app:icon="@drawable/ic_tw_schedule" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/tw_inset_panel"
            android:layout_marginTop="20dp" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nav_lists_title" android:textAppearance="@style/TextAppearance.Tracewall.Section" android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/nav_lists_body" android:textAppearance="@style/TextAppearance.Tracewall.Body" />
            <TextView android:id="@+id/updateSchedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="@style/TextAppearance.Tracewall.Caption" />
            <TextView android:id="@+id/updateResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/update_never" android:textAppearance="@style/TextAppearance.Tracewall.Caption" android:accessibilityLiveRegion="polite" />
            <com.google.android.material.button.MaterialButton android:id="@+id/openFeedHealth" style="@style/Widget.Tracewall.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="@string/nav_feed_health" app:icon="@drawable/ic_tw_globe" />
            <com.google.android.material.button.MaterialButton android:id="@+id/updateLists" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/nav_refresh_lists" app:icon="@drawable/ic_tw_refresh" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
