<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tw_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/appsToolbar"
        style="@style/Widget.Tracewall.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        app:navigationContentDescription="@string/detail_back"
        app:navigationIcon="@drawable/ic_tw_arrow_back"
        app:navigationIconTint="@color/tw_text"
        app:title="@string/detail_apps_title" />

    <TextView
        android:id="@+id/appsCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.Tracewall.Body"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:text="@string/detail_apps_intro"
        android:textAppearance="@style/TextAppearance.Tracewall.Caption" />

    <EditText
        android:id="@+id/filter"
        style="@style/Widget.Tracewall.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:drawableStart="@drawable/ic_tw_search"
        android:drawablePadding="12dp"
        android:drawableTint="@color/tw_muted"
        android:hint="@string/apps_filter"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text|textNoSuggestions"
        android:singleLine="true" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/appsProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:indeterminate="true"
        app:indicatorColor="@color/tw_primary"
        app:trackColor="@color/tw_surface_variant" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:scrollbars="vertical"
            android:visibility="gone" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/appsState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_tw_apps"
                    app:tint="@color/tw_primary" />

                <TextView
                    android:id="@+id/appsStateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Tracewall.Section" />

                <TextView
                    android:id="@+id/empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.Tracewall.Body"
                    android:textColor="@color/tw_muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/appsStateAction"
                    style="@style/Widget.Tracewall.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
