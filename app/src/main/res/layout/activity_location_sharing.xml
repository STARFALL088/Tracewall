<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:paddingBottom="32dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/locationBack"
            style="@style/Widget.Tracewall.Button.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/location_back" app:icon="@drawable/ic_tw_arrow_back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/location_title"
            android:textAppearance="@style/TextAppearance.Tracewall.Title" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/location_intro"
            android:textAppearance="@style/TextAppearance.Tracewall.Body" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:orientation="vertical"
            android:background="@drawable/tw_panel" android:padding="20dp">
            <ImageView android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_tw_location" android:importantForAccessibility="no" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/location_status_title"
                android:textAppearance="@style/TextAppearance.Tracewall.Section" android:accessibilityHeading="true" />
            <TextView android:id="@+id/locationStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/location_status_off" android:textAppearance="@style/TextAppearance.Tracewall.Body"
                android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/locationLastFix" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/location_last_never" android:textAppearance="@style/TextAppearance.Tracewall.Caption" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/location_privacy_note"
            android:textAppearance="@style/TextAppearance.Tracewall.Body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/locationStart"
            style="@style/Widget.Tracewall.Button"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/location_start"
            app:icon="@drawable/ic_tw_location" />
        <com.google.android.material.button.MaterialButton android:id="@+id/locationStop"
            style="@style/Widget.Tracewall.Button.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/location_stop" />
        <com.google.android.material.button.MaterialButton android:id="@+id/locationSettings"
            style="@style/Widget.Tracewall.Button.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/location_open_settings" />
    </LinearLayout>
</ScrollView>
